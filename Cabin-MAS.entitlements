<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build (make-mas.sh). The App Sandbox is mandatory on the store. -->
    <key>com.apple.security.app-sandbox</key>              <true/>
    <!-- Bandcamp, lyrics/credits/bio/map/show lookups, streaming. -->
    <key>com.apple.security.network.client</key>           <true/>
    <!-- The library lives in ~/Music/Vinyl; Apple Music imports read from ~/Music. -->
    <key>com.apple.security.assets.music.read-write</key>  <true/>
    <!-- Import files/folders the user picks (open panels). -->
    <key>com.apple.security.files.user-selected.read-write</key> <true/>
    <!-- Keep access to picked locations across launches. -->
    <key>com.apple.security.files.bookmarks.app-scope</key> <true/>
    <!-- CloudKit transfer of imported songs to the iOS app (same container as the DMG build). -->
    <key>com.apple.application-identifier</key>   <string>JLR4F273N8.com.cabin.player</string>
    <key>com.apple.developer.team-identifier</key> <string>JLR4F273N8</string>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.yoin.shared</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
</dict>
</plist>
